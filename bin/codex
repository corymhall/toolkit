#!/usr/bin/env bash

set -euo pipefail

find_real_codex() {
  local candidate

  while IFS= read -r candidate; do
    if [[ -n "$candidate" && ! "$candidate" -ef "$0" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(type -aP codex)

  return 1
}

automatically_trust_current_dir() {
  local codex_home config_path dir key

  codex_home="${CODEX_HOME:-$HOME/.codex}"
  config_path="$codex_home/config.toml"
  dir="$(pwd -P)"
  key="[projects.\"$dir\"]"

  mkdir -p "$codex_home"
  touch "$config_path"

  if rg --quiet -F "$key" "$config_path"; then
    return
  fi

  printf '\n%s\ntrust_level = "trusted"\n' "$key" >> "$config_path"
}

main() {
  local real_codex

  automatically_trust_current_dir

  real_codex="$(find_real_codex)" || {
    printf 'codex wrapper: could not find the real codex executable in PATH\n' >&2
    exit 1
  }

  exec "$real_codex" "$@"
}

main "$@"
