{
  "id": "root",
  "type": "row",
  "preview": "assets/toolkit-workbench/preview.svg",
  "background": "canvas",
  "children": [
    {
      "id": "sidebar",
      "type": "block",
      "size": {
        "px": 320
      },
      "min": 240,
      "max": 540,
      "content": {
        "mod": "toolkit-workbench",
        "props": {
          "repoAliases": {
            "pulumi-aws": "aws",
            "pulumi-terraform-bridge": "bridge"
          }
        }
      }
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "gap": 8,
              "radius": 8,
              "lone": true,
              "border": {
                "width": 1,
                "color": "border"
              },
              "focus": {
                "width": 1,
                "color": "accent"
              },
              "header": {
                "content": {
                  "mod": "pane"
                },
                "height": 30,
                "position": "top",
                "reveal": "always"
              }
            }
          }
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
