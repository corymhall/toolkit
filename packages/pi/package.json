{
  "name": "@corymhall/pi-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Pi extensions.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt extensions",
    "format:check": "oxfmt --check extensions",
    "lint": "oxlint extensions",
    "test": "npm run test:rex-subagents && npm run test:model-modes && npm run test:codex-fast-mode && npm run test:pi-ui && npm run test:command-runner && npm run test:system-prompt && npm run test:web-access && npm run test:review-pane && npm run test:github-pr",
    "test:rex-subagents": "node --experimental-strip-types --test extensions/rex-subagents/test/*.test.ts",
    "test:model-modes": "node --experimental-strip-types --test extensions/model-modes/test/*.test.ts",
    "test:github-pr": "node --experimental-strip-types --test extensions/github-pr/test/*.test.ts",
    "test:review-pane": "node --experimental-strip-types --test extensions/review-pane/test/*.test.ts",
    "test:codex-fast-mode": "node --experimental-strip-types --test extensions/codex-fast-mode/test/*.test.ts",
    "test:pi-ui": "node --experimental-strip-types --test extensions/pi-ui/test/*.test.ts extensions/pi-ui/*/test/*.test.ts",
    "test:command-runner": "node --experimental-strip-types --test extensions/command-runner/test/*.test.ts",
    "test:system-prompt": "node --experimental-strip-types --test extensions/system-prompt/test/*.test.ts",
    "test:web-access": "node --experimental-strip-types --test extensions/web-access/test/*.test.ts",
    "typecheck": "oxlint --type-aware --type-check extensions"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "ipaddr.js": "^2.4.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "extensions/web-access/index.ts",
      "extensions/codex-fast-mode/index.ts",
      "extensions/model-modes/index.ts",
      "extensions/pi-ui/index.ts",
      "extensions/system-prompt/index.ts",
      "extensions/command-runner/index.ts",
      "extensions/copy-session/index.ts",
      "extensions/github-pr/index.ts",
      "extensions/review-pane/index.ts",
      "extensions/rex-subagents/index.ts",
      "extensions/rex-session/index.ts"
    ]
  }
}
