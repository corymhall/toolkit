{
  "name": "@corymhall/toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Agent Skills and Pi extensions for AI-assisted software engineering workflows.",
  "scripts": {
    "format": "oxfmt extensions",
    "format:check": "oxfmt --check extensions",
    "lint": "oxlint extensions",
    "test": "npm run test:codex-fast-mode && npm run test:pi-ui && npm run test:session-default-model && npm run test:delegate && npm run test:herdr-command && npm run test:system-prompt && npm run test:web-access && npm run test:web-access:bun",
    "test:codex-fast-mode": "node --experimental-strip-types --test extensions/codex-fast-mode/test/*.test.ts",
    "test:pi-ui": "node --experimental-strip-types --test extensions/pi-ui/test/*.test.ts extensions/pi-ui/*/test/*.test.ts",
    "test:session-default-model": "node --experimental-strip-types --test extensions/session-default-model/test/*.test.ts",
    "test:delegate": "node --experimental-strip-types --test extensions/delegate/test/*.test.ts",
    "test:herdr-command": "node --experimental-strip-types --test extensions/herdr-command/test/*.test.ts",
    "test:system-prompt": "node --experimental-strip-types --test extensions/system-prompt/test/*.test.ts",
    "test:web-access": "node --experimental-strip-types --test extensions/web-access/test/*.test.ts",
    "test:web-access:bun": "bun test extensions/web-access/test/*.test.ts",
    "typecheck": "oxlint --type-aware --type-check extensions"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "ipaddr.js": "^2.4.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.0.1",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "keywords": [
    "agent-skills",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "extensions/web-access/index.ts",
      "extensions/codex-fast-mode/index.ts",
      "extensions/pi-ui/index.ts",
      "extensions/session-default-model/index.ts",
      "extensions/system-prompt/index.ts",
      "extensions/delegate/index.ts",
      "extensions/herdr-command/index.ts"
    ],
    "skills": [
      "skills",
      ".agents/skills"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/turndown": "5.0.6",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typebox": "1.3.27"
  }
}
