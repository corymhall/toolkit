#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: aws-docs-mcp <list|call> [mcporter arguments...]" >&2
  exit 2
fi

subcommand=$1
shift

case "$subcommand" in
  list|call)
    exec npx mcporter "$subcommand" \
      --stdio uvx \
      --stdio-arg awslabs.aws-documentation-mcp-server@latest \
      --env FASTMCP_LOG_LEVEL=ERROR \
      --env "AWS_DOCUMENTATION_PARTITION=${AWS_DOCUMENTATION_PARTITION:-aws}" \
      --name aws-docs \
      "$@"
    ;;
  *)
    echo "unsupported command: $subcommand (expected list or call)" >&2
    exit 2
    ;;
esac
