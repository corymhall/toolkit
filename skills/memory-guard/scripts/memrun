#!/usr/bin/env python3
from __future__ import annotations

import argparse
import ctypes
import json
import os
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path


def parse_size(value: str) -> int:
    text = value.strip().lower()
    suffixes = {"k": 1024, "kb": 1024, "m": 1024**2, "mb": 1024**2,
                "g": 1024**3, "gb": 1024**3}
    for suffix, multiplier in sorted(suffixes.items(), key=lambda item: -len(item[0])):
        if text.endswith(suffix):
            return int(float(text[: -len(suffix)].strip()) * multiplier)
    return int(float(text))


def format_size(size: int) -> str:
    for label, scale in (("GB", 1024**3), ("MB", 1024**2), ("KB", 1024)):
        if size >= scale:
            return f"{size / scale:.1f} {label}"
    return f"{size} B"


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


# Darwin sys/resource.h, struct rusage_info_v0. Physical footprint includes
# compressed memory, unlike ps RSS, and is the accounting used by Activity Monitor.
class RUsageInfoV0(ctypes.Structure):
    _fields_ = [("uuid", ctypes.c_uint8 * 16)] + [
        (name, ctypes.c_uint64) for name in (
            "user_time", "system_time", "pkg_idle_wkups", "interrupt_wkups",
            "pageins", "wired_size", "resident_size", "phys_footprint",
            "proc_start_abstime", "proc_exit_abstime",
        )
    ]


def load_proc_pid_rusage():
    if sys.platform != "darwin":
        return None
    try:
        function = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True).proc_pid_rusage
        function.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_void_p]
        function.restype = ctypes.c_int
        return function
    except (OSError, AttributeError):
        return None


_proc_pid_rusage = load_proc_pid_rusage()


def physical_footprint(pid: int) -> int | None:
    if _proc_pid_rusage is None:
        return None
    usage = RUsageInfoV0()
    if _proc_pid_rusage(pid, 0, ctypes.byref(usage)) != 0:
        return None  # The process may have exited between ps and this call.
    return int(usage.phys_footprint)


def read_processes() -> dict[int, dict[str, object]]:
    try:
        output = subprocess.check_output(
            ["/bin/ps", "-axo", "pid=,ppid=,rss=,command="],
            text=True, stderr=subprocess.DEVNULL,
        )
    except Exception:
        return {}
    processes = {}
    for line in output.splitlines():
        parts = line.strip().split(None, 3)
        if len(parts) < 3:
            continue
        try:
            pid, ppid, rss = int(parts[0]), int(parts[1]), int(parts[2]) * 1024
        except ValueError:
            continue
        processes[pid] = {
            "pid": pid, "ppid": ppid, "rss": rss,
            "command": parts[3] if len(parts) > 3 else "",
        }
    return processes


def process_tree(root_pid: int) -> list[dict[str, object]]:
    processes = read_processes()
    children_by_parent: dict[int, list[int]] = {}
    for pid, proc in processes.items():
        children_by_parent.setdefault(int(proc["ppid"]), []).append(pid)
    seen = set()
    queue = [root_pid]
    tree = []
    while queue:
        pid = queue.pop(0)
        if pid in seen:
            continue
        seen.add(pid)
        proc = processes.get(pid)
        if proc is not None:
            tree.append(proc)
        queue.extend(children_by_parent.get(pid, []))
    return tree


def snapshot(root_pid: int) -> tuple[int, int, list[dict[str, object]]]:
    tree = process_tree(root_pid)
    for proc in tree:
        footprint = physical_footprint(int(proc["pid"]))
        proc["physical_footprint"] = footprint
        proc["memory"] = max(int(proc["rss"]), footprint or 0)
    return (
        sum(int(proc["rss"]) for proc in tree),
        sum(int(proc["memory"]) for proc in tree),
        sorted(tree, key=lambda proc: int(proc["memory"]), reverse=True),
    )


def write_log(log_file: Path, event: dict[str, object]) -> None:
    event.setdefault("time", utc_now())
    with log_file.open("a", encoding="utf-8") as out:
        out.write(json.dumps(event, sort_keys=True) + "\n")


def capture_sample(pid: int, log_dir: Path, log_file: Path, reason: str) -> str | None:
    sample_path = log_dir / f"sample-{pid}-{int(time.time())}.txt"
    try:
        result = subprocess.run(
            ["/usr/bin/sample", str(pid), "3", "-file", str(sample_path)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=8, check=False,
        )
        if result.returncode != 0 or not sample_path.exists():
            raise RuntimeError(f"sample exited {result.returncode} without a usable capture")
    except Exception as exc:
        write_log(log_file, {"event": "sample_failed", "pid": pid,
                             "reason": reason, "error": str(exc)})
        return None
    write_log(log_file, {"event": "sample", "pid": pid, "reason": reason,
                         "path": str(sample_path)})
    return str(sample_path)


def terminate_process_group(pid: int) -> None:
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    except Exception:
        try:
            os.kill(pid, signal.SIGTERM)
        except Exception:
            return
    deadline = time.time() + 5
    while time.time() < deadline:
        try:
            # The leader may have exited while children still need escalation.
            os.killpg(pid, 0)
        except ProcessLookupError:
            return
        except PermissionError:
            # Darwin can deny probing a group containing only unreaped zombies.
            # Do not mistake an inconclusive probe for completed group cleanup.
            pass
        time.sleep(0.1)
    try:
        os.killpg(pid, signal.SIGKILL)
    except ProcessLookupError:
        return
    except Exception:
        try:
            os.kill(pid, signal.SIGKILL)
        except Exception:
            return


def env_value(neutral_name: str, legacy_name: str, default: str | None = None) -> str | None:
    return os.environ.get(neutral_name) or os.environ.get(legacy_name) or default


def default_log_dir() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return Path(state_home) / "toolkit" / "memrun"


class CommandInterrupted(BaseException):
    def __init__(self, signum: int):
        self.signum = signum
        super().__init__(signum)


def monitor(process, *, limit: int, sample_at: int, interval: float,
            log_dir: Path, log_file: Path, label: str) -> int:
    peak_rss = peak_memory = 0
    peak_tree: list[dict[str, object]] = []
    sampled = False
    try:
        while True:
            returncode = process.poll()
            rss, memory, tree = snapshot(process.pid)
            peak_rss = max(peak_rss, rss)
            if memory > peak_memory:
                peak_memory, peak_tree = memory, tree
            if tree:
                write_log(log_file, {"event": "rss", "root_pid": process.pid,
                                     "total_rss": rss, "total_memory": memory,
                                     "processes": tree[:10]})
            # Enforce the limit before the potentially slow sample capture.
            if memory >= limit:
                write_log(log_file, {"event": "kill", "root_pid": process.pid,
                                     "total_rss": rss, "total_memory": memory,
                                     "rss_limit": limit, "processes": tree[:20]})
                print(f"memrun: killing {label}; memory reached {format_size(memory)} "
                      f"over limit {format_size(limit)}; log {log_file}",
                      file=sys.stderr, flush=True)
                print(f"memrun: inspect {log_file} with the memory guard guidance before rerunning.",
                      file=sys.stderr, flush=True)
                terminate_process_group(process.pid)
                process.wait()
                return 137
            largest = tree[0] if tree else None
            if sample_at < limit and largest and not sampled and memory >= sample_at:
                sampled = True
                capture_sample(int(largest["pid"]), log_dir, log_file, "sample_threshold")
            if returncode is not None:
                write_log(log_file, {"event": "exit", "returncode": returncode,
                                     "peak_rss": peak_rss, "peak_memory": peak_memory,
                                     "peak_processes": peak_tree[:20]})
                print(f"memrun: {label} exited {returncode}; peak memory {format_size(peak_memory)}; "
                      f"peak RSS {format_size(peak_rss)}; log {log_file}",
                      file=sys.stderr, flush=True)
                return int(returncode)
            time.sleep(max(interval, 0.1))
    except (KeyboardInterrupt, CommandInterrupted) as exc:
        signum = exc.signum if isinstance(exc, CommandInterrupted) else signal.SIGINT
        write_log(log_file, {"event": "interrupt", "signal": signum,
                             "peak_rss": peak_rss, "peak_memory": peak_memory,
                             "peak_processes": peak_tree[:20]})
        terminate_process_group(process.pid)
        process.wait()
        return 128 + signum


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run a command with process-tree memory monitoring. On macOS, "
                    "count the greater of RSS and physical footprint for each process."
    )
    parser.add_argument("--rss-limit", default=env_value("MEMRUN_RSS_LIMIT", "CODEX_MEMRUN_RSS_LIMIT", "15g"),
                        help="Memory limit; legacy flag name retained for compatibility")
    parser.add_argument("--sample-at", default=env_value("MEMRUN_SAMPLE_AT", "CODEX_MEMRUN_SAMPLE_AT", "10g"))
    parser.add_argument("--interval", type=float,
                        default=float(env_value("MEMRUN_INTERVAL", "CODEX_MEMRUN_INTERVAL", "1.0")))
    parser.add_argument("--log-dir", default=env_value("MEMRUN_LOG_DIR", "CODEX_MEMRUN_LOG_DIR"))
    parser.add_argument("--label", default=env_value("MEMRUN_LABEL", "CODEX_MEMRUN_LABEL", "command"))
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        parser.error("missing command")
    limit, sample_at = parse_size(args.rss_limit), parse_size(args.sample_at)
    log_dir = Path(args.log_dir) if args.log_dir else default_log_dir()
    log_dir.mkdir(parents=True, exist_ok=True)
    log_file = log_dir / f"{datetime.now().strftime('%Y%m%d-%H%M%S')}-{os.getpid()}.jsonl"
    metric = "max(rss,physical_footprint)" if _proc_pid_rusage else "rss"
    env = os.environ.copy()
    env["MEMRUN_ACTIVE"] = env["CODEX_MEMRUN_ACTIVE"] = "1"
    print(f"memrun: running {args.label} with memory limit {format_size(limit)} "
          f"using {metric} (sample at {format_size(sample_at)}); log {log_file}",
          file=sys.stderr, flush=True)
    write_log(log_file, {"event": "start", "label": args.label, "command": command,
                         "rss_limit": limit, "sample_at": sample_at,
                         "memory_metric": metric, "cwd": os.getcwd()})

    interrupt_signal = None

    def interrupted(signum, _frame):
        nonlocal interrupt_signal
        # A second Ctrl+C or SIGTERM must not interrupt group cleanup.
        if interrupt_signal is None:
            interrupt_signal = signum
            raise CommandInterrupted(signum)

    previous = {sig: signal.signal(sig, interrupted) for sig in (signal.SIGINT, signal.SIGTERM)}
    try:
        process = subprocess.Popen(command, start_new_session=True, env=env)
        return monitor(process, limit=limit, sample_at=sample_at, interval=args.interval,
                       log_dir=log_dir, log_file=log_file, label=args.label)
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


if __name__ == "__main__":
    raise SystemExit(main())
